{
  "name": "@yourapp/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Code both sites use, imported as TypeScript source (no build step): API fetch core, Cognito auth helpers, UI primitives, formatting, and the Tailwind theme tokens (src/theme.css).",
