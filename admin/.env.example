# Build-time settings for the admin site. You rarely write these by hand:
#   scripts/deploy.sh      writes .env.production.local for the stage it deploys (from cdk-outputs-{stage}.json)
#   scripts/local-test.sh  writes .env.local-{stage}.local for `vite --mode local-{stage}` (scripts/local-test.sh admin)
# With none of them set, `npm run dev` runs with MOCK_AUTH: any email/password signs in as a mock admin, and the admin
# API answers from src/mock.ts (no backend).

# prod | test
VITE_STAGE=test
# Cognito (stack outputs UserPoolId / UserPoolClientId): the same pool as the user site, a separate session
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# The user site (stack output DomainName), for the "Open the site" link
VITE_SITE_URL=https://test.yourapp.com
