# Build-time settings for the site. You rarely write these by hand:
#   scripts/deploy.sh      writes .env.production.local for the stage it deploys (from cdk-outputs-{stage}.json)
#   scripts/local-test.sh  writes .env.local-{stage}.local for `vite --mode local-{stage}`
# With none of them set, `npm run dev` runs with MOCK_AUTH (any email/password, no backend; src/auth.ts).
# Don't keep a plain .env with a pool id: it would turn MOCK_AUTH off for every `npm run dev`.

# prod | test
VITE_STAGE=test
# Cognito (stack outputs UserPoolId / UserPoolClientId)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Test stage only: username login without Cognito (the API allows it only when STAGE=test)
VITE_TEST_LOGIN=1
# The admin site (stack output AdminUrl): the Admin link admins see in the user menu
VITE_ADMIN_URL=https://admin.test.yourapp.com
