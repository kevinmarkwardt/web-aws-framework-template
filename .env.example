# YourApp — deploy-time shell settings (optional).
#
# No secrets belong in this file. Runtime secrets live in AWS Secrets Manager, one set per stage, and the Lambdas read
# them by name:
#   yourapp/{stage}/stripe              Stripe keys (secretKey, webhookSecret, publishableKey): scripts/stripe-secret.sh
#                                       <stage> writes the key, scripts/stripe-setup.py the webhook secret
#   yourapp/test/test-login             test stage only: signing key for username logins, generated by CDK
# Optional plan price overrides live in DynamoDB (CONFIG | STRIPE), set on the admin site's Config tab.
# Admins are Cognito users in the "admins" group with isAdmin on their profile: scripts/make-admin.py <stage> <email>.
#
# The scripts don't read this file. Export what you need, or load it with: set -a; . ./.env; set +a

# Which stack the deploy and local-test scripts target: prod (yourapp.com) or test (test.yourapp.com)
STAGE=test

# AWS credentials/profile for the deploy scripts and CDK
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Set to 1 to skip the typed "prod" confirmation in scripts/deploy.sh (CI only)
# YES=1
